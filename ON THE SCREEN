- lblSaveBtn:
    Control: Label@2.5.1
    Properties:
      X: =819
      Y: =660
      Width: =140
      Height: =36
      Visible: =varShowModal
      Text: ="Save Meeting Notes"
      Size: =10
      FontWeight: =FontWeight.Semibold
      Font: =Font.'Segoe UI'
      Color: =RGBA(255, 255, 255, 1)
      Fill: =RGBA(0, 0, 0, 0)
      BorderColor: =RGBA(0, 0, 0, 0)
      Align: =Align.Center
      VerticalAlign: =VerticalAlign.Middle
      OnSelect: |
        =Set(
            varSavedMeeting,
            Patch(
                'Meeting Notes',
                Coalesce(varCurrentMeeting, Defaults('Meeting Notes')),
                {
                    Title: varCalRegion.Value & " Bi-Weekly Sync",
                    'Meeting Date': varCalSelected,
                    Region: varCalRegion,
                    'Meeting Recap': txtRecap.Value
                }
            )
        );
        ForAll(
            Filter(colEditActions, !Removed, !IsBlank(Trim(Descr))) As A,
            Patch(
                'Meeting Action Items',
                Coalesce(A.ActionRec, Defaults('Meeting Action Items')),
                {
                    Name: A.Descr,
                    'Action Description': A.Descr,
                    Meeting: varSavedMeeting,
                    'Assigned To': A.Assignee,
                    Status: A.Stat
                }
            )
        );
        ForAll(
            Filter(colEditActions, Removed, !IsBlank(ActionRec)) As D,
            Remove('Meeting Action Items', D.ActionRec)
        );
        If(
            IsEmpty(Errors('Meeting Notes')) && IsEmpty(Errors('Meeting Action Items')),
            Select(lblLoadData);
            Set(varShowModal, false);
            Clear(colEditActions);
            Notify("Meeting notes saved.", NotificationType.Success, 2000),
            Notify(
                "Save failed. " & First(Errors('Meeting Notes')).Message,
                NotificationType.Error
            )
        )
- lblLoadData:
    Control: Label@2.5.1
    Properties:
      X: =0
      Y: =0
      Width: =1
      Height: =1
      Visible: =false
      Text: =""
      Fill: =RGBA(0, 0, 0, 0)
      BorderColor: =RGBA(0, 0, 0, 0)
      OnSelect: |
        =ClearCollect(
            colMeetings,
            Filter('Meeting Notes', Region = varCalRegion)
        );
        ClearCollect(
            colCalEvents,
            ForAll(
                colMeetings As M,
                {
                    EventDate: DateValue(Text(M.'Meeting Date', "yyyy-mm-dd")),
                    Title: M.Title
                }
            )
        )
